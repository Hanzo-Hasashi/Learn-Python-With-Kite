# Required: use a random 32+ character secret and keep it out of source control.
KITE_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters

# Local development defaults to SQLite. For Supabase, use its PostgreSQL connection
# string (prefer the pooler URL and require SSL in production).
DATABASE_URL=sqlite:////data/kite.db

# Recommended production authentication/database configuration (Supabase).
SUPABASE_URL=
SUPABASE_ANON_KEY=
KITE_CORS_ORIGINS=https://your-app-domain.example,capacitor://localhost,http://localhost,https://localhost

# The code runner is a separate, private container.
RUNNER_URL=http://runner:8010
RUNNER_SHARED_SECRET=replace-with-a-different-random-secret

# Local fallback password reset only; Supabase manages provider verification and recovery email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Kite <learnwithkite.python@gmail.com>
PUBLIC_APP_URL=http://localhost:8000

# Google Play Developer API subscription verification.
GOOGLE_PLAY_PACKAGE_NAME=com.kite.learn
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-play-service-account.json
KITE_PLAY_MONTHLY_PRODUCT_ID=kite_premium_monthly
KITE_PLAY_ANNUAL_PRODUCT_ID=kite_premium_annual
KITE_MONTHLY_PRICE=K19.99
KITE_ANNUAL_PRICE=K99.99
