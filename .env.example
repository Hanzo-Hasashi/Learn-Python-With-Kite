# Local development template only. Set production values separately in Render.
KITE_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:////data/kite.db
KITE_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
KITE_ALLOW_LOCAL_AUTH=false

# Configure both values to enable Supabase Auth. Never use a service-role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
PUBLIC_APP_URL=http://localhost:8000

# If overriding the built-in CORS defaults, list exact trusted origins only.
# KITE_CORS_ORIGINS=http://localhost,https://localhost,capacitor://localhost
KITE_COOKIE_SECURE=false
KITE_COOKIE_SAMESITE=lax

# Local migrations use DATABASE_URL. Keep the owner URL out of the web service environment.
# MIGRATION_DATABASE_URL=

# Supabase production template. Do not use this template with real credentials committed to Git.
# DATABASE_URL=postgresql+psycopg://kite_runtime:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# MIGRATION_DATABASE_URL=postgresql+psycopg://kite_migrator:[PASSWORD]@[DIRECT-HOST]:5432/postgres?sslmode=require
# SUPABASE_URL=https://[PROJECT_REF].supabase.co
# SUPABASE_ANON_KEY=[PUBLISHABLE-KEY]
# PUBLIC_APP_URL=https://[FRONTEND-HOST]
# PUBLIC_API_URL=https://[BACKEND-HOST]

# Local password-recovery fallback only. Hosted Supabase Auth email uses Supabase SMTP settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Kite <noreply@example.com>

# The isolated runner is available in the local Docker Compose setup, not on Render Free.
RUNNER_URL=http://runner:8010
RUNNER_SHARED_SECRET=replace-with-a-different-random-secret-at-least-32-characters

# Optional Google Play verification configuration; do not commit service-account credentials.
GOOGLE_PLAY_PACKAGE_NAME=com.kite.learn
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-play-service-account.json
KITE_PLAY_MONTHLY_PRODUCT_ID=kite_premium_monthly
KITE_PLAY_ANNUAL_PRODUCT_ID=kite_premium_annual
KITE_MONTHLY_PRICE=K19.99
KITE_ANNUAL_PRICE=K99.99

# Optional Zambia mobile-money checkout. Keep disabled until the integration is configured and tested.
KITE_PAWAPAY_ENABLED=false
KITE_PAWAPAY_ENV=sandbox
KITE_PAWAPAY_API_TOKEN=
KITE_PAWAPAY_MONTHLY_AMOUNT=19.99
KITE_PAWAPAY_ANNUAL_AMOUNT=99.99

# Lenco remains disabled by default. Never enable these flags until merchant and collection contracts are confirmed.
KITE_LENCO_BASE_URL=https://api.lenco.co/access/v2
KITE_LENCO_API_TOKEN=
KITE_LENCO_PUBLIC_KEY=
KITE_LENCO_COLLECTION_ENABLED=false
KITE_LENCO_ZMW_COLLECTION_CONFIRMED=false
