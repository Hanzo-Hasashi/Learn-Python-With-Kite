# ==============================================================================
# KITE BACKEND — RENDER WEB SERVICE ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# This template is for Render Web Service deployment.
# Configure these variables in the Render Dashboard under:
#   Service -> Environment -> Environment Variables / Secret Files
# NEVER commit actual secrets or production passwords to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME (MANDATORY)
# ------------------------------------------------------------------------------
KITE_ENV=production
LOG_LEVEL=INFO

# Random 64-character hexadecimal string (minimum 32 characters)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
KITE_SECRET_KEY=replace-with-a-random-secret-key-at-least-32-characters

# Disable insecure local fallback authentication in production
KITE_ALLOW_LOCAL_AUTH=false

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL DATABASE (MANDATORY)
# ------------------------------------------------------------------------------
# Restricted runtime user (kite_runtime) with sslmode=require.
# Connect through Supabase's transaction pooler (port 5432 or 6543) in eu-west-1.
# Notice: Do NOT use the postgres owner role for the runtime DATABASE_URL.
DATABASE_URL=postgresql+psycopg://kite_runtime.izdtxorekfpasdkgasvs:[RUNTIME_PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 3. SUPABASE AUTH INTEGRATION (MANDATORY)
# ------------------------------------------------------------------------------
# Supabase project URL and publishable anon key.
# Found in Supabase Dashboard -> Project Settings -> API.
# NEVER place the service_role key here.
SUPABASE_URL=https://izdtxorekfpasdkgasvs.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-publishable-anon-key

# ------------------------------------------------------------------------------
# 4. FRONTEND, CORS, AND COOKIES (MANDATORY)
# ------------------------------------------------------------------------------
# The confirmed official hosted frontend on Vercel
PUBLIC_APP_URL=https://learnpythonwithkite.vercel.app

# Exact allowed CORS origins (comma-separated, NO wildcards, NO localhost in prod)
KITE_CORS_ORIGINS=https://learnpythonwithkite.vercel.app

# Production cookie security
KITE_COOKIE_SECURE=true
KITE_COOKIE_SAMESITE=lax

# ------------------------------------------------------------------------------
# 5. FRONTEND INTEGRATION ARCHITECTURE (CHOOSE OPTION A OR OPTION B)
# ------------------------------------------------------------------------------
# OPTION A: Vercel Same-Origin Proxy Mode (Recommended for vercel.app + onrender.com)
# In this mode, Vercel proxies /api/* to Render with a shared secret header,
# keeping cookies first-party on learnpythonwithkite.vercel.app.
#
KITE_VERCEL_PROXY=true
PUBLIC_API_URL=https://learnpythonwithkite.vercel.app
KITE_PROXY_SECRET=replace-with-shared-proxy-secret-at-least-32-characters
# KITE_PROXY_SECRET_PREVIOUS=optional-previous-secret-for-zero-downtime-rotation

# OPTION B: Direct Cross-Origin Mode with Custom Domain
# Used when you own a custom domain (e.g., learnpythonwithkite.com).
# In this mode, both frontend and backend must use subdomains of KITE_COOKIE_SITE.
# (Browsers block cross-site cookies between raw vercel.app and onrender.com).
#
# KITE_VERCEL_PROXY=false
# PUBLIC_API_URL=https://api.learnpythonwithkite.com
# KITE_COOKIE_SITE=learnpythonwithkite.com

# ------------------------------------------------------------------------------
# 6. GATED / DISABLED PAYMENT INTEGRATIONS (MANDATORY: KEEP DISABLED)
# ------------------------------------------------------------------------------
# Lenco mobile money collections must remain strictly FALSE until contracts are confirmed
KITE_LENCO_BASE_URL=https://api.lenco.co/access/v2
KITE_LENCO_API_TOKEN=
KITE_LENCO_PUBLIC_KEY=
KITE_LENCO_COLLECTION_ENABLED=false
KITE_LENCO_ZMW_COLLECTION_CONFIRMED=false

# PawaPay mobile money integration (disabled)
KITE_PAWAPAY_ENABLED=false

# ------------------------------------------------------------------------------
# 7. OPTIONAL INTEGRATIONS (UNCONFIGURED / DISABLED ON RENDER FREE)
# ------------------------------------------------------------------------------
# Separate Render Web Service for the isolated Python runner.
# Set RUNNER_URL to the runner's HTTPS origin, for example:
# https://kite-playground.onrender.com
# RUNNER_URL=
# Generate a random 32+-character secret and set the exact same value on both services.
# RUNNER_SHARED_SECRET=

# Google Play in-app subscription verification (optional)
# GOOGLE_PLAY_PACKAGE_NAME=com.kite.learn
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/google-play-service-account.json
# KITE_PLAY_MONTHLY_PRODUCT_ID=kite_premium_monthly
# KITE_PLAY_ANNUAL_PRODUCT_ID=kite_premium_annual

# Email fallback (Supabase Auth handles user confirmation and password reset emails)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Kite <noreply@example.com>
